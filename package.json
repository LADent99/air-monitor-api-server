{
  "name": "air-monitor-api-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
